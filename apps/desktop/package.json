{
    "name": "@kn/desktop",
    "version": "0.0.1",
    "private": true,
    "description": "Knowledge Desktop Application",
    "author": "KN Team",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite dev --watch",
        "build": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite build",
        "preview": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite preview",
        "package": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite build && electron-builder --mac --win --linux",
        "package:win": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite build && electron-builder --win",
        "package:mac": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite build && electron-builder --mac",
        "package:linux": "NODE_OPTIONS='--max-old-space-size=16384' electron-vite build && electron-builder --linux",
        "rebuild:native": "node scripts/rebuild-sqlite.cjs",
        "rebuild:native:node": "node scripts/rebuild-sqlite.cjs --node",
        "check:storage": "rm -rf .tmp-check/storage && tsc --noEmitOnError src/main/storage/sqlite-store.check.ts --rootDir src/main/storage --outDir .tmp-check/storage --module commonjs --target ES2020 --lib ES2020,DOM --types node --esModuleInterop --skipLibCheck --strict && node .tmp-check/storage/sqlite-store.check.js",
        "check:net-policy": "rm -rf .tmp-check/net-policy && tsc --noEmitOnError src/main/net-policy.check.ts --rootDir src/main --outDir .tmp-check/net-policy --module commonjs --target ES2020 --lib ES2020,DOM --types node --esModuleInterop --skipLibCheck --strict && node .tmp-check/net-policy/net-policy.check.js",
        "test:storage:electron": "ELECTRON_RUN_AS_NODE= electron src/main/storage/electron.smoke.cjs --no-sandbox --disable-gpu --user-data-dir=.tmp-check/electron-userdata",
        "test:capabilities:electron": "ELECTRON_RUN_AS_NODE= electron src/main/capabilities/electron.smoke.cjs --no-sandbox --disable-gpu",
        "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
    },
    "devDependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^3.0.0",
        "@electron/rebuild": "^4.2.1",
        "@kn/chart-plugin": "workspace:*",
        "@kn/core": "workspace:*",
        "@kn/file-manager": "workspace:*",
        "@kn/plugin-ai": "workspace:*",
        "@kn/plugin-api-client": "workspace:*",
        "@kn/plugin-bitable": "workspace:*",
        "@kn/plugin-block-reference": "workspace:*",
        "@kn/plugin-github": "workspace:*",
        "@kn/plugin-logicflow": "workspace:*",
        "@kn/plugin-main": "workspace:*",
        "@kn/plugin-plugin-studio": "workspace:*",
        "@kn/plugin-speech-to-text": "workspace:*",
        "@kn/plugin-theme": "workspace:*",
        "@kn/plugin-zhihu": "workspace:*",
        "@kn/ui": "workspace:*",
        "@types/better-sqlite3": "^9.6.0",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.7.4",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^5.1.3",
        "autoprefixer": "^10.4.21",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^5.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^8.57.0",
        "fs-extra": "^11.2.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.3",
        "vite": "^7.3.1",
        "vite-tsconfig-paths": "^6.1.0"
    },
    "build": {
        "appId": "com.kn.desktop",
        "productName": "KN Desktop",
        "directories": {
            "buildResources": "resources",
            "output": "release"
        },
        "files": [
            "out/**/*",
            "!**/node_modules/**/*"
        ],
        "afterPack": "./scripts/afterPack.cjs",
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "category": "public.app-category.productivity"
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "category": "Office"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "better-sqlite3": "^12.11.1",
        "ssh2": "^1.17.0"
    }
}