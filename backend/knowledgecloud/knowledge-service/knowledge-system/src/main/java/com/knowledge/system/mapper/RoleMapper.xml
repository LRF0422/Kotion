<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.system.mapper.RoleMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="roleResultMap" type="com.knowledge.system.domain.Role">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="role_name" property="roleName"/>
        <result column="sort" property="sort"/>
        <result column="role_alias" property="roleAlias"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <resultMap id="roleVoResultMap" type="com.knowledge.system.domain.vo.RoleVO">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="role_name" property="roleName"/>
        <result column="role_alias" property="roleAlias"/>
        <result column="sort" property="sort"/>
        <result column="admin" property="admin"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="baseColumnList">
        select
        id, parent_id, role_name, sort, role_alias, is_deleted
    </sql>

    <select id="selectRolePage" resultMap="roleResultMap">
        select * from knowledge_role where is_deleted = 0
    </select>

    <select id="tree" resultMap="roleVoResultMap">
        SELECT id, parent_id, role_name, role_alias, sort, admin
        FROM knowledge_role
        WHERE tenant_id = #{tenantId}
          AND is_deleted = 0
        <if test="excludeRole != null">
            AND role_alias &lt;&gt; #{excludeRole}
        </if>
        ORDER BY sort ASC, id ASC
    </select>

    <select id="getRoleNames" resultType="java.lang.String">
        SELECT
        role_name
        FROM
        knowledge_role
        WHERE
        id IN
        <foreach collection="array" item="ids" index="index" open="(" close=")" separator=",">
            #{ids}
        </foreach>
        and is_deleted = 0
    </select>

</mapper>
