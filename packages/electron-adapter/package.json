{
  "name": "@kn/electron-adapter",
  "version": "0.0.1",
  "private": true,
  "description": "Electron adapter layer for Knowledge Desktop",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "registry": "http://localhost:8081/repository/npm-hosted/"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^11.8.1",
    "eventemitter3": "^5.0.1",
    "fs-extra": "^11.2.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "rollup": "4.45.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "electron": "^28.0.0"
  }
}