# Server Configuration
PORT=1234

# SSL Configuration
SSL_ENABLED=false
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# Room authentication.
# When set, every client joining a `page:{pageId}` room must present a valid
# access token granting READ on that page; verification is delegated to the wiki
# service. When unset, rooms are UNAUTHENTICATED — anyone knowing a page id can
# read and write that page's live document.
# AUTH_API_BASE_URL=http://knowledge-gateway:8888
# AUTH_TIMEOUT_MS=5000

# Database Configuration (MySQL)
#
# Persistence is REQUIRED for collaboration to survive a room emptying or a
# server restart. Without it the Y.Doc is in-memory only, and block data kept
# beside the document — e.g. the spreadsheet L3 workbook map — is lost.
# The table `collab_documents` is created automatically on start.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=knowledge_wiki
# DB_TABLE=collab_documents
# DB_POOL_SIZE=10
#
# Store is debounced so a fast editor does not write on every update.
# STORE_DEBOUNCE_MS=2000
# STORE_MAX_DEBOUNCE_MS=10000

# Redis Configuration (optional)
#
# Relays rooms between multiple room-server instances. It is NOT a durable store,
# so the MySQL configuration above is still required.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
